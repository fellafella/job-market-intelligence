# Copiez ce fichier en ".env" : cp .env.example .env

POSTGRES_USER=jobs
POSTGRES_PASSWORD=jobs
POSTGRES_DB=warehouse
POSTGRES_PORT=5432

# Sous Linux : AIRFLOW_UID=$(id -u) pour éviter les problèmes de permissions
AIRFLOW_UID=50000
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# Catégories Remotive à collecter, séparées par des virgules (data, software-dev, devops...)
JOBS_CATEGORIES=data

# true = données d'exemple locales, sans appel à l'API
USE_SAMPLE_DATA=false
